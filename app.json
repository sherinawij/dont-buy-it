{
  "expo": {
    "name": "Don't Buy It!",
    "slug": "dont-buy-it",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#DDF2E1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Sprout needs to see the thing you want to buy.",
          "cameraPermission": "Sprout needs to see the thing you want to buy."
        }
      ],
      "expo-sharing"
    ],
    "scheme": "dontbuyit"
  }
}
