rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    // Social features need a real account (email/password), not an anonymous guest.
    function registered() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function isUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // ---------- Private data ----------
    // Each user can only read and write their own data under users/{uid}.
    match /users/{userId} {
      // Settings doc: owner only.
      allow read, write: if isUser(userId);

      // Items feed "spending avoided" (Home's jar, Sprout, and the friends leaderboard), so writes are
      // validated: real amounts, known statuses, and a decision can't be changed or re-counted later.
      match /items/{itemId} {
        allow read, delete: if isUser(userId);
        allow create: if isUser(userId) && validItem(request.resource.data)
          && request.resource.data.status == 'debating'
          && request.resource.data.get('decidedAt', null) == null;
        allow update: if isUser(userId) && validItem(request.resource.data)
          && (resource.data.status == 'debating' || lockedAfterDecision());
      }

      // Any other private sub-collection: owner only (same as before).
      match /{collection}/{document=**} {
        allow read, write: if isUser(userId) && collection != 'items';
      }
    }

    function money(v) {
      return v == null || ((v is int || v is float) && v >= 0 && v <= 1000000);
    }
    function validItem(d) {
      return d.name is string && d.name.size() <= 200
        && money(d.get('price', null))
        && money(d.get('estimatedPrice', null))
        && money(d.get('alternativePrice', null))
        && d.status in ['debating', 'resisted', 'bought']
        && (d.get('outcome', null) == null || d.outcome in ['sprout_won', 'user_won', 'overridden', 'essential', 'alternative'])
        && d.get('messages', []) is list && d.get('messages', []).size() <= 200;
    }
    // Once decided, the debate can still save messages, but the decision and the amounts are fixed.
    function lockedAfterDecision() {
      return request.resource.data.status == resource.data.status
        && request.resource.data.get('outcome', null) == resource.data.get('outcome', null)
        && request.resource.data.get('price', null) == resource.data.get('price', null)
        && request.resource.data.get('estimatedPrice', null) == resource.data.get('estimatedPrice', null)
        && request.resource.data.get('decidedAt', null) == resource.data.get('decidedAt', null);
    }

    // ---------- Public profiles ----------
    // Only a username and display name: no email, no items, no money. Readable by other accounts
    // so they can find friends. Each user writes only their own, and only with a username they hold.
    match /profiles/{userId} {
      allow read: if registered();
      allow create, update: if registered() && isUser(userId) && validProfile()
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == request.auth.uid;
      allow delete: if false;
    }

    function validProfile() {
      let d = request.resource.data;
      return d.keys().hasOnly(['username', 'usernameLower', 'displayName', 'createdAt', 'updatedAt'])
        && d.username is string && d.usernameLower is string && d.displayName is string
        && d.usernameLower.matches('^[a-z0-9_]{3,20}$')
        && d.username.lower() == d.usernameLower
        && d.displayName.size() >= 1 && d.displayName.size() <= 40;
    }

    // ---------- Username registry: usernames/{lowercase name} → { uid } ----------
    // One doc per name makes usernames unique regardless of capitalisation.
    // A name can only be claimed together with the claimer's profile (same batch), so nobody can
    // hoard names; it can only be released by its holder once their profile has moved off it.
    match /usernames/{name} {
      allow read: if registered();
      allow create: if registered()
        && name.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.usernameLower == name;
      allow delete: if registered()
        && resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.usernameLower != name;
      allow update: if false;
    }

    // ---------- Friendships: friendships/{uidA_uidB} (uids sorted → one doc per pair) ----------
    // Only the two people involved can see or change it. Requests start 'pending';
    // only the recipient can accept; either person can delete (decline, cancel, remove).
    match /friendships/{pairId} {
      // Reading a pair that doesn't exist yet is allowed only for your own pairs (needed to send a request),
      // so nobody can probe whether two other people are friends.
      allow read: if registered() && (
        (resource == null && request.auth.uid in pairId.split('_'))
        || (resource != null && request.auth.uid in resource.data.members)
      );
      allow create: if registered() && validNewRequest(pairId);
      allow update: if registered()
        && request.auth.uid == resource.data.recipient
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if registered() && request.auth.uid in resource.data.members;
    }

    function validNewRequest(pairId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['members', 'requester', 'recipient', 'status', 'createdAt', 'updatedAt'])
        && d.requester == request.auth.uid
        && d.recipient is string && d.recipient != d.requester
        && d.status == 'pending'
        && d.members is list && d.members.size() == 2
        && d.members[0] < d.members[1]
        && d.requester in d.members && d.recipient in d.members
        && pairId == d.members[0] + '_' + d.members[1]
        // Both people must have a public profile (so the request shows who it's from).
        && exists(/databases/$(database)/documents/profiles/$(d.requester))
        && exists(/databases/$(database)/documents/profiles/$(d.recipient));
    }
  }
}
