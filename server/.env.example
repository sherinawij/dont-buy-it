# Copy to server/.env (never commit it). On Vercel, set these in Project → Settings → Environment Variables.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the main model is overloaded (503) or rate-limited (429)
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
# Optional: MINIMAL | LOW | MEDIUM | HIGH (lower = faster)
GEMINI_THINKING_LEVEL=LOW
PORT=3001
