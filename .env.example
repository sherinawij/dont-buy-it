# Copy this file to .env and fill in the values. Never commit .env.
# Firebase: Project settings → General → Your apps → Web app → firebaseConfig
EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:abc123

# Backend that talks to Gemini (your Vercel URL, or http://<your-computer-ip>:3001 locally)
EXPO_PUBLIC_API_URL=https://your-backend.vercel.app
